{
  "gow": {
    "title": "God of War (2018)",
    "exe": "GoW.exe",
    "texpack_version": 5,
    "dirs": {
      "wad": "exec/wad/pc_le",
      "exec": "exec"
    },
    "lang": {
      "table": "languages/LANGS_*.txt",
      "items": [
        "sound/pc_le/{lang}",
        "wad/pc_le/soundbanks/{lang}"
      ],
      "voices": {
        "0": "japanese",
        "1": "english(us)",
        "2": "french(france)",
        "3": "spanish(spain)",
        "4": "german",
        "5": "italian",
        "7": "portuguese(portugal)",
        "8": "russian",
        "16": "polish",
        "17": "portuguese(brazil)",
        "20": "spanish(mexico)",
        "25": "greek"
      }
    },
    "app": {
      "name": "God of War",
      "requires": [],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Removes the top two mip levels of every streamed texture.",
          "saved": "34.6 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "2",
            "--in-place"
          ],
          "repeat_warning": "Running it again removes two more mip levels."
        },
        {
          "id": "shvol",
          "title": "Lighting volumes",
          "text": "Halves the resolution of the SH lighting volumes in the .wad files.",
          "saved": "2.1 GiB",
          "args": [
            "shvol",
            "{game_dir}"
          ],
          "requires": [
            "numpy"
          ]
        },
        {
          "id": "lang",
          "title": "Voice languages",
          "text": "Keeps the English voice-over and removes the other languages.",
          "saved": "3.2 GiB",
          "args": [
            "lang",
            "{game_dir}",
            "--keep",
            "english"
          ]
        }
      ]
    }
  },
  "gowr": {
    "title": "God of War Ragnarok",
    "exe": "GoWR.exe",
    "texpack_version": 6,
    "dirs": {
      "wad": "exec/wad/pc_le",
      "exec": "exec"
    },
    "lang": {
      "table": "languages/LANGS_*.txt",
      "items": [
        "sound/pc_le/{lang}.0.audiopack",
        "sound/pc_le/{lang}.audiopack.toc",
        "wad/pc_le/soundbanks/{lang}"
      ],
      "voices": {
        "0": "japanese",
        "1": "english(us)",
        "2": "french(france)",
        "3": "spanish(spain)",
        "4": "german",
        "5": "italian",
        "7": "portuguese(portugal)",
        "8": "russian",
        "16": "polish",
        "17": "portuguese(brazil)",
        "20": "spanish(mexico)",
        "21": "arabic",
        "25": "greek"
      }
    },
    "app": {
      "name": "God of War Ragnarök",
      "requires": [
        "lz4"
      ],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Removes the top two mip levels of every streamed texture.",
          "saved": "89.0 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "2",
            "--in-place"
          ],
          "repeat_warning": "Running it again removes two more mip levels."
        },
        {
          "id": "lang",
          "title": "Voice languages",
          "text": "Keeps the English voice-over and removes the other languages.",
          "saved": "16.7 GiB",
          "args": [
            "lang",
            "{game_dir}",
            "--keep",
            "english"
          ]
        }
      ]
    }
  },
  "shf": {
    "title": "SILENT HILL f",
    "exe": "SHf.exe",
    "dirs": {
      "wad": "SHf/Content/Paks"
    },
    "app": {
      "name": "SILENT HILL f",
      "requires": [
        "ooz=pyooz",
        "numpy"
      ],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Removes the top two mip levels of every streamed texture and repacks SHf-Windows.ucas without its patch padding.",
          "saved": "21.9 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "2",
            "--in-place"
          ],
          "repeat_warning": "Without a backup, running it again removes two more mip levels."
        }
      ]
    }
  },
  "re8": {
    "title": "Resident Evil Village",
    "exe": "re8.exe",
    "app": {
      "name": "Resident Evil Village",
      "requires": [],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Shrinks every streamed texture to the resolution of its base copy (two mip levels down) and rewrites the .pak files.",
          "saved": "17.9 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "2",
            "--in-place"
          ]
        },
        {
          "id": "lang",
          "title": "Voice languages",
          "text": "Keeps the English voice-over and empties the other languages' voice packs and banks inside the .pak files.",
          "saved": "3.3 GiB",
          "args": [
            "lang",
            "{game_dir}",
            "--keep",
            "english"
          ]
        },
        {
          "id": "prune",
          "title": "Replaced patch data",
          "text": "Removes the entries of re_chunk_000.pak and its patch paks that a later patch pak replaces.",
          "saved": "1.6 GiB",
          "args": [
            "prune",
            "{game_dir}"
          ]
        }
      ]
    }
  }
}

{
  "ah": {
    "title": "Atomic Heart",
    "exe": "AtomicHeart.exe",
    "dirs": {
      "wad": "AtomicHeart/Content/Paks",
      "exec": "AtomicHeart/Content/Paks"
    },
    "app": {
      "name": "Atomic Heart",
      "requires": [],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Removes the top mip level of every streamed texture (textures used by the UI are left as they are) and rewrites the .pak files.",
          "saved": "20.6 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "1",
            "--in-place"
          ],
          "repeat_warning": "Without a backup, running it again removes one more mip level."
        },
        {
          "id": "lightmap",
          "title": "Lightmaps",
          "text": "Removes the top mip level of the baked lightmap and shadowmap textures and rewrites the .pak files.",
          "saved": "30.7 GiB",
          "args": [
            "lightmap",
            "{game_dir}",
            "--drop",
            "1",
            "--in-place"
          ],
          "repeat_warning": "Without a backup, running it again removes one more mip level."
        },
        {
          "id": "lang",
          "title": "Voice languages",
          "text": "Keeps the English voice-over and removes the other languages' Wwise files and lip-sync animations from the .pak files.",
          "saved": "15.1 GiB",
          "args": [
            "lang",
            "{game_dir}",
            "--keep",
            "english"
          ]
        },
        {
          "id": "repack",
          "title": "Compress .pak files",
          "text": "Compresses the entries of the uncompressed .pak files with zlib. Voice and video files are left as they are.",
          "saved": "66.8 GiB",
          "args": [
            "repack",
            "{game_dir}"
          ]
        }
      ]
    }
  },
  "gow": {
    "title": "God of War (2018)",
    "exe": "GoW.exe",
    "texpack_version": 5,
    "dirs": {
      "wad": "exec/wad/pc_le",
      "exec": "exec"
    },
    "lang": {
      "table": "languages/LANGS_*.txt",
      "items": [
        "sound/pc_le/{lang}",
        "wad/pc_le/soundbanks/{lang}"
      ],
      "voices": {
        "0": "japanese",
        "1": "english(us)",
        "2": "french(france)",
        "3": "spanish(spain)",
        "4": "german",
        "5": "italian",
        "7": "portuguese(portugal)",
        "8": "russian",
        "16": "polish",
        "17": "portuguese(brazil)",
        "20": "spanish(mexico)",
        "25": "greek"
      }
    },
    "app": {
      "name": "God of War",
      "requires": [],
      "install_dirs": [],
      "steps": [
        {
          "id": "mipdrop",
          "title": "Textures",
          "text": "Removes the top two mip levels of every streamed texture.",
          "saved": "34.6 GiB",
          "args": [
            "mipdrop",
            "{game_dir}",
            "--drop",
            "2",
            "--in-place"
          ],
          "repeat_warning": "Running it again removes two more mip levels."
        },
        {
          "id": "shvol",
          "title": "Lighting volumes",
          "text": "Halves the resolution of the SH lighting volumes in the .wad files.",
          "saved": "2.1 GiB",
          "args": [
            "shvol",
            "{game_dir}"
          ],
          "requires": [
            "numpy"
          ]
        },
        {
          "id": "lang",
          "title": "Voice languages",
          "text": "Keeps the English voice-over and removes the other languages.",
          "saved": "3.2 GiB",
          "args": [
            "lang",
            "{game_dir}",
            "--keep",
            "english"
          ]
        }
      ]
    }
  },
